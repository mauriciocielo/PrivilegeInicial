generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String   @id @default(uuid())
  name                 String
  email                String   @unique
  password             String
  role                 String
  empresaIds           String[]
  avatarData           String?
  receberEmailDiario   Boolean  @default(false)
  allowedRoutes        String[]
  createdAt            DateTime @default(now())
  phone                String?
  twoFactorEnabled     Boolean  @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]
}

model Empresa {
  id                         String               @id @default(uuid())
  razaoSocial                String
  nomeFantasia               String
  cnpj                       String               @unique
  responsavel                String
  email                      String
  telefone                   String
  atividade                  String?
  tipo                       String               @default("empresa")
  taxaMensalPadrao           Float?
  fundoReservaPct            Float?
  dataInicioContrato         String?
  grupoEconomico             String?
  receitaMensalEstimada      Float?
  comprasMensalEstimada      Float?
  logoData                   String?
  bancoBoleto                String               @default("nenhum")
  politicaReceberName        String?
  politicaReceberData        String?
  politicaComprasName        String?
  politicaComprasData        String?
  politicaCobrancaName       String?
  politicaCobrancaData       String?
  createdAt                  DateTime             @default(now())
  allowedRoutes              String[]
  // Endereço — exigido na qualificação das partes do contrato de prestação
  // de serviços, que antes era digitado manualmente a cada emissão.
  endereco                   String?
  cep                        String?
  cidade                     String?
  uf                         String?
  // Termos comerciais do contrato, cadastrados uma vez e reaproveitados na
  // emissão do documento.
  contratoValorTotal         Float?
  contratoValorEntrada       Float?
  contratoParcelas           Int?
  contratoDiaVencimento      Int?
  contratoPrimeiroVencimento String?
  contratoInicioServicos     String?
  contratoDuracaoMeses       Int?
  contratoHorasSemanais      Int?
  // Descricao dos servicos do Anexo I, editavel por cliente.
  contratoServicos           String?
  // Regime tributário — usado na qualificação da API de CP/CR (relatórios
  // fiscais dependem dele) e não existia em nenhum campo do cadastro.
  regimeTributario           String?
  contasReceber              ContaReceber[]
  contasPagar                ContaPagar[]
  // Campos abaixo (os*) e a relação ApiKey pertencem à integração "OS Oficina"
  // de outra sessão, já aplicados ao banco — preservados tal como estão lá.
  osPlanoContaPadraoId       String?
  osPortadorPadraoId         String?
  osWebhookUrl               String?
  osWebhookSecret            String?
  apiKeys                    ApiKey[]
  atas                       AtaAtendimento[]
  clientes                   Cliente[]
  endividamentos             Endividamento[]
  indicadores                IndicadorMensal[]
  lancamentos                Lancamento[]
  nfsList                    NfsE[]
  orcamentos                 OrcamentoMensal[]
  planoContas                PlanoConta[]
  portadores                 Portador[]
  situacoesFiscais           SituacaoFiscal[]
  patterns                   TransactionPattern[]
  unidades                   Unidade[]
  contasBalanco              ContaBalanco[]
  balancosPatrimoniais       BalancoPatrimonial[]
  diagnosticos360            Diagnostico360[]
  imobilizados               Imobilizado[]
  curvaAbcConfig             CurvaAbcConfig?
  curvasAbc                  CurvaAbc[]
  regrasCategorizacao        RegraCategorizacaoOFX[]
  documentosEntrada          DocumentoEntrada[]
  lotesPagamento             LotePagamento[]
  regrasCobranca             ReguaCobranca[]
  slasFechamento             SLAFechamento[]
}

model Unidade {
  id              String       @id @default(uuid())
  condominioId    String
  identificacao   String
  proprietario    String
  proprietarioCpf String?
  fracaoIdeal     Float
  email           String
  telefone        String
  moradorNome     String?
  moradorCpf      String?
  moradorEmail    String?
  moradorTelefone String?
  lancamentos     Lancamento[]
  condominio      Empresa      @relation(fields: [condominioId], references: [id], onDelete: Cascade)
}

model PlanoConta {
  id           String               @id @default(uuid())
  codigo       String
  descricao    String
  tipo         String
  nivel        Int
  parentId     String?
  ativo        Boolean              @default(true)
  empresaId    String
  dreCategoria String?
  lancamentos  Lancamento[]
  empresa      Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  parent       PlanoConta?          @relation("PlanoContaHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     PlanoConta[]         @relation("PlanoContaHierarchy")
  patterns     TransactionPattern[]
}

model Portador {
  id               String       @id @default(uuid())
  nome             String
  tipo             String
  banco            String?
  agencia          String?
  conta            String?
  saldoInicial     Float
  saldoInicialData String?
  ativo            Boolean      @default(true)
  empresaId        String
  lancamentos      Lancamento[]
  empresa          Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model Endividamento {
  id                String                        @id @default(uuid())
  empresaId         String
  tipo              String
  banco             String
  conta             String
  contrato          String
  descricaoContrato String?
  taxa              Float
  taxaTipo          String?
  indexador         String
  parcela           Int
  parcelasFaltantes Int
  valorQuitacao     Float
  valorAPagar       Float
  garantia          String
  pagamentoMes      Int
  empresa           Empresa                       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pagamentos        PagamentoEndividamento[]
  historicoSaldos   HistoricoSaldoEndividamento[]
}

model HistoricoSaldoEndividamento {
  id              String        @id @default(uuid())
  endividamentoId String
  mes             String
  saldoDevedor    Float
  createdAt       DateTime      @default(now())
  endividamento   Endividamento @relation(fields: [endividamentoId], references: [id], onDelete: Cascade)
}

model PagamentoEndividamento {
  id               String        @id @default(uuid())
  endividamentoId  String
  data             String
  valorTotal       Float
  valorJuros       Float
  valorAmortizacao Float
  endividamento    Endividamento @relation(fields: [endividamentoId], references: [id], onDelete: Cascade)
}

model AtaAtendimento {
  id                  String    @id @default(uuid())
  empresaId           String
  consultorId         String
  data                String
  titulo              String
  conteudo            String
  participantes       String
  createdAt           DateTime  @default(now())
  // Vínculo com o documento no Autentique, quando a ata foi enviada para
  // assinatura eletrônica. A situação de cada signatário fica na plataforma e
  // é consultada sob demanda — aqui guardamos apenas a referência.
  assinaturaId        String?
  assinaturaEnviadaEm DateTime?
  empresa             Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model IndicadorMensal {
  id            String  @id @default(uuid())
  empresaId     String
  mes           String
  faturamento   Float
  compras       Float
  inadimplencia Float
  empresa       Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model OrcamentoMensal {
  id        String           @id @default(uuid())
  empresaId String
  mes       String
  empresa   Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  valores   OrcamentoValor[]
}

model OrcamentoValor {
  id           String          @id @default(uuid())
  orcamentoId  String
  planoContaId String
  valor        Float
  orcamento    OrcamentoMensal @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
}

model ContaBalanco {
  id        String         @id @default(uuid())
  empresaId String
  grupo     String // ativo_circulante | ativo_nao_circulante | passivo_circulante | passivo_nao_circulante | patrimonio_liquido
  subgrupo  String? // ex: "Imobilizado", "Realizável a Longo Prazo" (subdivisão opcional dentro do grupo)
  codigo    String
  descricao String
  ordem     Int            @default(0)
  ativo     Boolean        @default(true)
  createdAt DateTime       @default(now())
  empresa   Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  valores   BalancoValor[]

  @@index([empresaId])
}

model BalancoPatrimonial {
  id          String         @id @default(uuid())
  empresaId   String
  competencia String // YYYY-MM
  observacao  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  empresa     Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  valores     BalancoValor[]

  @@unique([empresaId, competencia])
  @@index([empresaId])
}

model BalancoValor {
  id             String             @id @default(uuid())
  balancoId      String
  contaBalancoId String
  valor          Float              @default(0)
  balanco        BalancoPatrimonial @relation(fields: [balancoId], references: [id], onDelete: Cascade)
  contaBalanco   ContaBalanco       @relation(fields: [contaBalancoId], references: [id], onDelete: Cascade)

  @@unique([balancoId, contaBalancoId])
}

model Diagnostico360 {
  id          String   @id @default(uuid())
  empresaId   String
  data        String
  consultor   String
  respondente Json
  respostas   Json
  anotacoes   Json
  parecer     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
}

model CurvaAbcConfig {
  id          String  @id @default(uuid())
  empresaId   String  @unique
  percentualA Float   @default(80)
  percentualB Float   @default(95)
  empresa     Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model CurvaAbc {
  id             String         @id @default(uuid())
  empresaId      String
  nome           String
  dataImportacao String
  percentualA    Float
  percentualB    Float
  createdAt      DateTime       @default(now())
  empresa        Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  itens          CurvaAbcItem[]

  @@index([empresaId])
}

model CurvaAbcItem {
  id                   String   @id @default(uuid())
  curvaId              String
  nome                 String
  valorFaturado        Float
  percentualIndividual Float
  percentualAcumulado  Float
  classificacao        String
  ordem                Int
  curva                CurvaAbc @relation(fields: [curvaId], references: [id], onDelete: Cascade)

  @@index([curvaId])
}

model Lancamento {
  id              String     @id @default(uuid())
  empresaId       String
  data            String
  descricao       String
  valor           Float
  tipo            String
  planoContaId    String
  portadorId      String
  status          String
  numeroDocumento String?
  observacao      String?
  origem          String     @default("manual")
  ofxId           String?
  unidadeId       String?
  clienteId       String?
  attachmentName  String?
  attachmentData  String?
  conferido       Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt
  // Vínculo com Ordem de Serviço — integração "OS Oficina" de outra sessão.
  osNumero        String?
  osParcela       Int?
  // Espelho de um título lançado via API v1 (contas a pagar/receber) — quando
  // preenchido, este lançamento "previsto" é o reflexo, no fluxo clássico
  // (Contas a Receber/Pagar, baixa manual, conciliação OFX), de uma linha do
  // livro-razão imutável ContaReceber/ContaPagar. Ao marcar este lançamento
  // como "realizado" (baixa manual ou reconciliação bancária), o sistema dá
  // baixa automaticamente na conta correspondente — ver app/api/lancamentos.
  contaReceberId  String?
  contaPagarId    String?
  cliente         Cliente?   @relation(fields: [clienteId], references: [id])
  empresa         Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  planoConta      PlanoConta @relation(fields: [planoContaId], references: [id])
  portador        Portador   @relation(fields: [portadorId], references: [id])
  unidade         Unidade?   @relation(fields: [unidadeId], references: [id])
  nfsList         NfsE[]

  @@unique([empresaId, osNumero, osParcela])
}

model Cliente {
  id                        String         @id @default(uuid())
  empresaId                 String
  tipo                      String
  nome                      String
  nomeFantasia              String?
  cpfCnpj                   String
  email                     String?
  telefone                  String?
  celular                   String?
  endereco                  String?
  cidade                    String?
  estado                    String?
  cep                       String?
  contato                   String?
  observacao                String?
  limiteCredito             Float?
  ativo                     Boolean        @default(true)
  createdAt                 DateTime       @default(now())
  empresa                   Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  lancamentos               Lancamento[]
  nfsList                   NfsE[]
  contasReceberComoSacado   ContaReceber[] @relation("ContasReceberComoSacado")
  contasPagarComoFornecedor ContaPagar[]   @relation("ContasPagarComoFornecedor")
}

model NfsE {
  id                          String      @id @default(uuid())
  empresaId                   String
  numero                      String
  serie                       String      @default("1")
  codigoVerificacao           String?
  status                      String
  motivoCancelamento          String?
  prestadorCnpj               String
  prestadorRazaoSocial        String
  prestadorInscricaoMunicipal String?
  prestadorEndereco           String?
  prestadorCidade             String?
  prestadorUf                 String?
  prestadorCep                String?
  clienteId                   String?
  tomadorCnpjCpf              String
  tomadorRazaoSocial          String
  tomadorEmail                String?
  tomadorEndereco             String?
  tomadorCidade               String?
  tomadorUf                   String?
  tomadorCep                  String?
  tomadorInscricaoMunicipal   String?
  dataEmissao                 String
  dataCompetencia             String
  codigoServico               String
  cnae                        String?
  discriminacao               String
  municipioPrestacao          String?
  valorServicos               Float
  valorDeducoes               Float
  valorPis                    Float
  valorCofins                 Float
  valorInss                   Float
  valorIr                     Float
  valorCsll                   Float
  issRetido                   Boolean     @default(false)
  valorIss                    Float
  aliquotaIss                 Float
  valorBaseCalculo            Float
  valorLiquido                Float
  lancamentoId                String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime?   @updatedAt
  cliente                     Cliente?    @relation(fields: [clienteId], references: [id])
  empresa                     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  lancamento                  Lancamento? @relation(fields: [lancamentoId], references: [id])
}

model TransactionPattern {
  id         String     @id @default(uuid())
  empresaId  String
  pattern    String
  categoryId String
  planoConta PlanoConta @relation(fields: [categoryId], references: [id])
  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model SituacaoFiscal {
  id              String  @id @default(uuid())
  empresaId       String
  dataVerificacao String
  status          String
  observacoes     String
  empresa         Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model Atividade {
  id            String   @id @default(uuid())
  empresaId     String
  descricao     String
  tempoSegundos Int
  data          String
  lat           Float?
  lng           Float?
  fotoInicio    String?
  fotoFim       String?
  createdAt     DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  empresaId String
  timestamp String
  userName  String
  action    String
  details   String
  createdAt DateTime @default(now())

  @@index([empresaId])
}

model CentroCusto {
  id        String   @id @default(uuid())
  empresaId String
  nome      String
  codigo    String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([empresaId])
}

model AgendaTask {
  id          String   @id @default(uuid())
  title       String
  empresaId   String
  consultorId String
  horario     String
  day         String
  completed   Boolean  @default(false)
  recurrent   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([empresaId])
}

model InteligenciaDoc {
  id        String   @id @default(uuid())
  name      String
  type      String
  size      Int
  content   String
  createdAt DateTime @default(now())
}

model Imobilizado {
  id              String   @id @default(uuid())
  empresaId       String
  nome            String
  dataAquisicao   String
  valorAquisicao  Float
  taxaDepreciacao Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
}

/// Politicas financeiras do escritorio, compartilhadas com todos os clientes.
model PoliticaGlobal {
  id        String   @id
  texto     String
  updatedAt DateTime @default(now()) @updatedAt
}

/// Faturamento e despesas previstos pelo consultor, por competencia.
/// Alimentam a projecao de caixa quando nao ha lancamentos previstos suficientes.
model ProjecaoFaturamento {
  id          String   @id
  empresaId   String
  competencia String
  faturamento Float
  despesas    Float
  observacao  String?
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([empresaId, competencia])
  @@index([empresaId])
}

// ============================================================
// API v1 — INTEGRAÇÃO COM O ERP DO CLIENTE (CP/CR)
// ============================================================
// Livro-razão PRÓPRIO, separado do model Lancamento. O Lancamento é editado
// livremente em ~20 telas do portal (reclassificado, excluído, corrigido pelo
// consultor) — não há como impor imutabilidade pós-conciliação nele sem
// quebrar esses fluxos. Um dado que chega assinado pelo ERP do cliente, via
// API, precisa da garantia oposta: uma vez conciliado, só se reverte por
// estorno (lançamento de contrapartida), nunca por edição ou DELETE.
//
// Sacado/fornecedor reaproveita o model Cliente já existente (campo `tipo`
// distingue 'cliente' | 'fornecedor' | 'ambos') — não duplicamos cadastro.

// A credencial de API (ApiKey) já existe no banco — foi criada por outra
// sessão para a integração "OS Oficina" (id, empresaId, nome, chaveHash,
// prefixo, ativo, ultimoUsoEm, revokedAt: exatamente o que este módulo
// precisava). Reaproveitada aqui em vez de duplicar um segundo sistema de
// chaves; o model ApiKey está declarado mais abaixo, junto dos campos `os*`
// de Empresa/Lancamento que vieram na mesma migration.

/// Log de auditoria de toda requisição da API v1 que altera dados — obrigação
/// explícita do escopo, com granularidade diferente do AuditLog interno
/// (aquele guarda ações do usuário no portal; este guarda o payload bruto e o
/// IP de cada chamada externa).
model ApiAuditLog {
  id         String   @id @default(uuid())
  empresaId  String?
  keyId      String?
  metodo     String
  endpoint   String
  ip         String?
  statusCode Int
  payload    String?
  erro       String?
  criadoEm   DateTime @default(now())

  @@index([empresaId])
  @@index([criadoEm])
}

enum StatusContaFinanceira {
  aberto
  parcial
  liquidado
  cancelado
}

model ContaReceber {
  id                 String                @id @default(uuid())
  empresaId          String
  sacadoId           String
  planoContaId       String?
  numeroDocumento    String?
  descricao          String?
  documentoFiscalUrl String?
  dataEmissao        String
  dataVencimento     String
  dataCompetencia    String
  valorOriginal      Float
  acrescimos         Float                 @default(0)
  descontos          Float                 @default(0)
  valorLiquido       Float
  status             StatusContaFinanceira @default(aberto)
  /// Informativo — como o ERP espera que este título seja pago (ex.: "PIX",
  /// "Cartão de crédito 3x"). Não baixa nada sozinho, só orienta o consultor.
  formaPagamentoPrevista String?
  origemApiKeyId     String?
  conciliadoEm       DateTime?
  canceladoEm        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @default(now()) @updatedAt
  empresa            Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sacado             Cliente               @relation("ContasReceberComoSacado", fields: [sacadoId], references: [id])
  baixas             ContaReceberBaixa[]
  reguaLogs          ReguaCobrancaLog[]

  @@index([empresaId])
  @@index([sacadoId])
  @@index([status])
}

/// Cada baixa é um registro imutável e aditivo (append-only). Uma baixa
/// incorreta nunca é editada ou apagada — é estornada por outra baixa de
/// valor negativo com `estornoDeId` apontando para a original.
model ContaReceberBaixa {
  id             String       @id @default(uuid())
  contaReceberId String
  data           String
  valor          Float
  formaPagamento String?
  observacao     String?
  estornoDeId    String?
  createdAt      DateTime     @default(now())
  contaReceber   ContaReceber @relation(fields: [contaReceberId], references: [id], onDelete: Cascade)

  @@index([contaReceberId])
}

model ContaPagar {
  id              String                @id @default(uuid())
  empresaId       String
  fornecedorId    String
  planoContaId    String?
  centroCustoId   String?
  numeroDocumento String?
  descricao       String?
  dataEmissao     String
  dataVencimento  String
  valorOriginal   Float
  acrescimos      Float                 @default(0)
  descontos       Float                 @default(0)
  valorLiquido    Float
  status          StatusContaFinanceira @default(aberto)
  /// Informativo — como o título será pago (ex.: "Boleto 30 dias"). Não
  /// baixa nada sozinho, só orienta o consultor.
  formaPagamentoPrevista String?
  origemApiKeyId  String?
  conciliadoEm    DateTime?
  canceladoEm     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @default(now()) @updatedAt
  empresa         Empresa               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  fornecedor      Cliente               @relation("ContasPagarComoFornecedor", fields: [fornecedorId], references: [id])
  baixas          ContaPagarBaixa[]
  lotePagamentoId String?
  lotePagamento   LotePagamento?        @relation(fields: [lotePagamentoId], references: [id])

  @@index([empresaId])
  @@index([fornecedorId])
  @@index([status])
}

model ContaPagarBaixa {
  id             String     @id @default(uuid())
  contaPagarId   String
  data           String
  valor          Float
  formaPagamento String?
  observacao     String?
  estornoDeId    String?
  createdAt      DateTime   @default(now())
  contaPagar     ContaPagar @relation(fields: [contaPagarId], references: [id], onDelete: Cascade)

  @@index([contaPagarId])
}

/// Assinatura de webhook: para onde o BPO notifica o ERP do cliente quando
/// uma CR é liquidada/conciliada.
model WebhookSubscription {
  id        String   @id @default(uuid())
  empresaId String
  url       String
  eventos   String[]
  segredo   String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([empresaId])
}

/// Log de entrega — cada tentativa de envio, com o resultado, para permitir
/// reenvio manual e diagnóstico de integração sem depender do cliente avisar.
model WebhookDelivery {
  id             String   @id @default(uuid())
  subscriptionId String
  evento         String
  payload        String
  statusCode     Int?
  sucesso        Boolean  @default(false)
  tentativas     Int      @default(1)
  criadoEm       DateTime @default(now())

  @@index([subscriptionId])
}

/// Credencial de API por empresa — criada pela integração "OS Oficina" de
/// outra sessão, reaproveitada aqui como o único sistema de chaves de API do
/// produto (evita duas tabelas de credencial fazendo a mesma coisa).
/// Formato do token exposto ao cliente: "{prefixo}.{secret}" — prefixo é
/// público e permite localizar a linha em O(1); só o hash do secret é salvo.
model ApiKey {
  id          String    @id @default(uuid())
  empresaId   String
  nome        String
  chaveHash   String    @unique
  prefixo     String
  ativo       Boolean   @default(true)
  ultimoUsoEm DateTime?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  empresa     Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
}

// ============================================================
// MÓDULOS DE AUTOMAÇÃO BPO - CFOaaS
// ============================================================

model RegraCategorizacaoOFX {
  id             String   @id @default(uuid())
  empresaId      String
  condicao       String   // ex: "STARTS_WITH:PGTO VIVO", "CONTAINS:TARIFA BANCARIA"
  planoContaId   String
  tipoMovimento  String   // "ENTRADA" | "SAIDA"
  createdAt      DateTime @default(now())
  empresa        Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  planoConta     PlanoConta @relation(fields: [planoContaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
}

model DocumentoEntrada {
  id               String   @id @default(uuid())
  empresaId        String
  arquivoUrl       String
  tipoDocumento    String   // "XML_NFE" | "PDF_BOLETO" | "RECIBO"
  hashProcessamento String?  @unique
  lido             Boolean  @default(false)
  dadosExtraidos   Json?
  status           String   @default("PENDENTE") // PENDENTE, APROVADO, REJEITADO, ERRO
  createdAt        DateTime @default(now())
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([status])
}

model LotePagamento {
  id              String       @id @default(uuid())
  empresaId       String
  dataAgendamento String       // Dia programado para o lote
  status          String       @default("CRIADO") // CRIADO, AGUARDANDO_CLIENTE, APROVADO, EXPORTADO
  arquivoCnabUrl  String?      
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt
  empresa         Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  contasPagar     ContaPagar[] // Relação 1-N

  @@index([empresaId])
}

model ReguaCobranca {
  id               String   @id @default(uuid())
  empresaId        String
  nome             String
  templateAviso    String   // Template de mensagem p/ WhatsApp/Email
  diasAntesOuDepois Int      // ex: -3 (3 dias antes), 0 (no dia), +5 (5 dias depois)
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now())
  empresa          Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
}

model ReguaCobrancaLog {
  id               String       @id @default(uuid())
  contaReceberId   String
  enviadoEm        DateTime     @default(now())
  sucesso          Boolean
  erroDetalhe      String?
  contaReceber     ContaReceber @relation(fields: [contaReceberId], references: [id], onDelete: Cascade)

  @@index([contaReceberId])
}

model SLAFechamento {
  id                   String   @id @default(uuid())
  empresaId            String
  competencia          String   // "2026-09"
  status               String   @default("ABERTO") // ABERTO, EM_ANDAMENTO, ATRASADO, CONCLUIDO
  responsavelId        String?
  percentualProgresso  Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
  empresa              Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, competencia])
}
