generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  password           String
  role               String
  empresaIds         String[]
  avatarData         String?
  receberEmailDiario Boolean  @default(false)
  allowedRoutes      String[]
  createdAt          DateTime @default(now())
  phone              String?
}

model Empresa {
  id                    String               @id @default(uuid())
  razaoSocial           String
  nomeFantasia          String
  cnpj                  String               @unique
  responsavel           String
  email                 String
  telefone              String
  atividade             String?
  tipo                  String               @default("empresa")
  taxaMensalPadrao      Float?
  fundoReservaPct       Float?
  dataInicioContrato    String?
  grupoEconomico        String?
  receitaMensalEstimada Float?
  comprasMensalEstimada Float?
  logoData              String?
  bancoBoleto           String               @default("nenhum")
  createdAt             DateTime             @default(now())
  allowedRoutes         String[]
  atas                  AtaAtendimento[]
  clientes              Cliente[]
  endividamentos        Endividamento[]
  indicadores           IndicadorMensal[]
  lancamentos           Lancamento[]
  nfsList               NfsE[]
  orcamentos            OrcamentoMensal[]
  planoContas           PlanoConta[]
  portadores            Portador[]
  situacoesFiscais      SituacaoFiscal[]
  patterns              TransactionPattern[]
  unidades              Unidade[]
}

model Unidade {
  id              String       @id @default(uuid())
  condominioId    String
  identificacao   String
  proprietario    String
  proprietarioCpf String?
  fracaoIdeal     Float
  email           String
  telefone        String
  moradorNome     String?
  moradorCpf      String?
  moradorEmail    String?
  moradorTelefone String?
  lancamentos     Lancamento[]
  condominio      Empresa      @relation(fields: [condominioId], references: [id], onDelete: Cascade)
}

model PlanoConta {
  id           String               @id @default(uuid())
  codigo       String
  descricao    String
  tipo         String
  nivel        Int
  parentId     String?
  ativo        Boolean              @default(true)
  empresaId    String
  dreCategoria String?
  lancamentos  Lancamento[]
  empresa      Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  parent       PlanoConta?          @relation("PlanoContaHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     PlanoConta[]         @relation("PlanoContaHierarchy")
  patterns     TransactionPattern[]
}

model Portador {
  id               String       @id @default(uuid())
  nome             String
  tipo             String
  banco            String?
  agencia          String?
  conta            String?
  saldoInicial     Float
  saldoInicialData String?
  ativo            Boolean      @default(true)
  empresaId        String
  lancamentos      Lancamento[]
  empresa          Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model Endividamento {
  id                String                   @id @default(uuid())
  empresaId         String
  tipo              String
  banco             String
  conta             String
  contrato          String
  descricaoContrato String?
  taxa              Float
  taxaTipo          String?
  indexador         String
  parcela           Int
  parcelasFaltantes Int
  valorQuitacao     Float
  valorAPagar       Float
  garantia          String
  pagamentoMes      Int
  empresa           Empresa                  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pagamentos        PagamentoEndividamento[]
}

model PagamentoEndividamento {
  id               String        @id @default(uuid())
  endividamentoId  String
  data             String
  valorTotal       Float
  valorJuros       Float
  valorAmortizacao Float
  endividamento    Endividamento @relation(fields: [endividamentoId], references: [id], onDelete: Cascade)
}

model AtaAtendimento {
  id            String   @id @default(uuid())
  empresaId     String
  consultorId   String
  data          String
  titulo        String
  conteudo      String
  participantes String
  createdAt     DateTime @default(now())
  empresa       Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model IndicadorMensal {
  id            String  @id @default(uuid())
  empresaId     String
  mes           String
  faturamento   Float
  compras       Float
  inadimplencia Float
  empresa       Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model OrcamentoMensal {
  id        String           @id @default(uuid())
  empresaId String
  mes       String
  empresa   Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  valores   OrcamentoValor[]
}

model OrcamentoValor {
  id           String          @id @default(uuid())
  orcamentoId  String
  planoContaId String
  valor        Float
  orcamento    OrcamentoMensal @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
}

model Lancamento {
  id              String     @id @default(uuid())
  empresaId       String
  data            String
  descricao       String
  valor           Float
  tipo            String
  planoContaId    String
  portadorId      String
  status          String
  numeroDocumento String?
  observacao      String?
  origem          String     @default("manual")
  ofxId           String?
  unidadeId       String?
  clienteId       String?
  attachmentName  String?
  attachmentData  String?
  createdAt       DateTime   @default(now())
  cliente         Cliente?   @relation(fields: [clienteId], references: [id])
  empresa         Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  planoConta      PlanoConta @relation(fields: [planoContaId], references: [id])
  portador        Portador   @relation(fields: [portadorId], references: [id])
  unidade         Unidade?   @relation(fields: [unidadeId], references: [id])
  nfsList         NfsE[]
}

model Cliente {
  id            String       @id @default(uuid())
  empresaId     String
  tipo          String
  nome          String
  nomeFantasia  String?
  cpfCnpj       String
  email         String?
  telefone      String?
  celular       String?
  endereco      String?
  cidade        String?
  estado        String?
  cep           String?
  contato       String?
  observacao    String?
  limiteCredito Float?
  ativo         Boolean      @default(true)
  createdAt     DateTime     @default(now())
  empresa       Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  lancamentos   Lancamento[]
  nfsList       NfsE[]
}

model NfsE {
  id                          String      @id @default(uuid())
  empresaId                   String
  numero                      String
  serie                       String      @default("1")
  codigoVerificacao           String?
  status                      String
  motivoCancelamento          String?
  prestadorCnpj               String
  prestadorRazaoSocial        String
  prestadorInscricaoMunicipal String?
  prestadorEndereco           String?
  prestadorCidade             String?
  prestadorUf                 String?
  prestadorCep                String?
  clienteId                   String?
  tomadorCnpjCpf              String
  tomadorRazaoSocial          String
  tomadorEmail                String?
  tomadorEndereco             String?
  tomadorCidade               String?
  tomadorUf                   String?
  tomadorCep                  String?
  tomadorInscricaoMunicipal   String?
  dataEmissao                 String
  dataCompetencia             String
  codigoServico               String
  cnae                        String?
  discriminacao               String
  municipioPrestacao          String?
  valorServicos               Float
  valorDeducoes               Float
  valorPis                    Float
  valorCofins                 Float
  valorInss                   Float
  valorIr                     Float
  valorCsll                   Float
  issRetido                   Boolean     @default(false)
  valorIss                    Float
  aliquotaIss                 Float
  valorBaseCalculo            Float
  valorLiquido                Float
  lancamentoId                String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime?   @updatedAt
  cliente                     Cliente?    @relation(fields: [clienteId], references: [id])
  empresa                     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  lancamento                  Lancamento? @relation(fields: [lancamentoId], references: [id])
}

model TransactionPattern {
  id         String     @id @default(uuid())
  empresaId  String
  pattern    String
  categoryId String
  planoConta PlanoConta @relation(fields: [categoryId], references: [id])
  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}

model SituacaoFiscal {
  id              String  @id @default(uuid())
  empresaId       String
  dataVerificacao String
  status          String
  observacoes     String
  empresa         Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
}
