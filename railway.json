{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build"
  },
  "deploy": {
    "startCommand": "NODE_ENV=production NFE_MONITOR_DESATIVADO=1 NFSE_RELATORIO_DESATIVADO=1 node server.js",
    "numReplicas": 1,
    "restartPolicyType": "ALWAYS"
  }
}
